# Placeholders only. Resolved by `sv materialize --cwd /services/muster` into /etc/homelab/secrets/muster.env.
# muster_api is a dedicated least-privilege role (nexus migration 1889); never the shared ariaadmin credential.
DATABASE_URL=postgresql://{aws:secret:muster/database#username}:{aws:secret:muster/database#password}@127.0.0.1:5432/nexus
# muster_admin holds EXECUTE on the 1895 and 1897 SECURITY DEFINER admin functions. Create the LOGIN role
# on the nexus cluster and store its credential at vault secret muster/admin-database before deploying them.
MUSTER_ADMIN_DATABASE_URL=postgresql://{aws:secret:muster/admin-database#username}:{aws:secret:muster/admin-database#password}@127.0.0.1:5432/nexus
