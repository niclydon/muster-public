# Placeholders only. Resolved by `sv materialize --cwd /services/muster/operator-console` into
# /etc/homelab/secrets/muster-operator-console.env, which the nexus-mcp unit loads (OB-60221).
# operator-console is the persistent operator principal the nexus-mcp Muster management tools sign as.
# The key is stored single-line (base64 PKCS#8 DER) because env files cannot carry a multi-line PEM.
MUSTER_API_URL=http://127.0.0.1:7880
MUSTER_AUDIENCE=muster:furnace
MUSTER_OPERATOR_SIGNING_KEY={aws:secret:muster/operator-console#private_key_b64}
MUSTER_OPERATOR_TOKEN={aws:secret:muster/operator-console#token}
# OB-60233: nexus-mcp stream tools (muster_message_post / muster_messages_read / muster_delivery_ack) signed as this seat.
MUSTER_STREAM_TOOLS=on
