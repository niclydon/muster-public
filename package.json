{
  "name": "muster",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-runtime agent coordination: registry, conditions, stream.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @muster/core",
    "typecheck": "npm run typecheck -w @muster/core",
    "test": "vitest run",
    "check:boundary": "node scripts/check-import-boundary.mjs",
    "check": "npm run check:boundary && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
